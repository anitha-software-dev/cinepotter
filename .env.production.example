# Production host / .env.production only (never required for localhost).
#
# Official Google snippets map to:
#   gtag.js        → VITE_GA_MEASUREMENT_ID (e.g. G-XXXXXXXXXX)
#   GTM + noscript → VITE_GTM_ID (e.g. GTM-XXXXXXX)
#   Clarity        → VITE_CLARITY_PROJECT_ID
#
# If GA is loaded via gtag here, do NOT also add GA4 Configuration inside GTM.
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_CLARITY_PROJECT_ID=
